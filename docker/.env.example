# ─────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values:
#     cp .env.example .env
# .env is git-ignored and must NEVER be committed (contains secrets).
# In the cloud deploy the VM generates docker/.env automatically from the
# Terraform `env` variable, so this template is only for local/manual use.
# ─────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────────
# Must match what's in the SQL dump (cooldatabase)
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_2026!
MYSQL_DATABASE=cooldatabase
MYSQL_USER=cooluser
MYSQL_PASSWORD=CHANGE_ME_db_2026!

# ── WordPress DB connection ──────────────────────────────────
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_NAME=cooldatabase
WORDPRESS_DB_USER=cooluser
WORDPRESS_DB_PASSWORD=CHANGE_ME_db_2026!

# ── phpMyAdmin ───────────────────────────────────────────────
PMA_HOST=mysql

# ── WordPress admin (used by wp-setup.sh) ────────────────────
WP_URL=https://localhost
WP_TITLE="La Nube del Gato Argentino"
WP_ADMIN_USER=elgatoargentino
WP_ADMIN_PASSWORD=CHANGE_ME_admin_2026!
WP_ADMIN_EMAIL=test@test.com
